# Copy to .env and fill in. .env is gitignored.

# Datadog (required)
DD_API_KEY=
# Application key with the ai_guard_evaluate scope (required for AI Guard)
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_ENV=demo

# Set to false to make AI Guard monitor-only regardless of the service policy
# DD_AI_GUARD_BLOCK=false

# LLM backends
OPENAI_API_KEY=
# Ollama running on the Docker host
OLLAMA_HOST=http://host.docker.internal:11434
